<script>
    // ============================================================
    // JAVASCRIPT — Page Inscription
    // ============================================================

    (function() {
        'use strict';

        // ============================================================
        // 1. TOAST
        // ============================================================
        function showToast(message, type = 'success') {
            const existing = document.querySelectorAll('.toast-notification');
            existing.forEach(t => t.remove());
            
            const toast = document.createElement('div');
            toast.className = 'toast-notification';
            toast.setAttribute('role', 'alert');
            
            const colors = {
                success: 'var(--couleur-succes)',
                error: 'var(--couleur-erreur)',
                info: 'var(--couleur-accent-principal)'
            };
            toast.style.background = colors[type] || colors.info;
            
            toast.innerHTML = `
                        <span>${message}</span>
                        <button class="toast-close" aria-label="Fermer">✕</button>
                    `;
            document.body.appendChild(toast);
            
            toast.querySelector('.toast-close').addEventListener('click', function() {
                toast.classList.add('out');
                setTimeout(() => toast.remove(), 300);
            });
            
            setTimeout(() => {
                if (toast.parentNode) {
                    toast.classList.add('out');
                    setTimeout(() => toast.remove(), 300);
                }
            }, 3500);
        }

        // ============================================================
        // 2. PASSWORD STRENGTH
        // ============================================================
        function checkPasswordStrength(password) {
            let strength = 0;
            if (password.length >= 6) strength++;
            if (password.length >= 10) strength++;
            if (/[A-Z]/.test(password) && /[a-z]/.test(password)) strength++;
            if (/\d/.test(password)) strength++;
            if (/[^A-Za-z0-9]/.test(password)) strength++;
            
            if (strength <= 1) return { level: 'weak', text: 'ضعيف', score: 1 };
            if (strength <= 3) return { level: 'medium', text: 'متوسط', score: 2 };
            return { level: 'strong', text: 'قوي', score: 3 };
        }

        function updatePasswordStrength() {
            const password = document.getElementById('password').value;
            const result = checkPasswordStrength(password);
            
            const bars = [document.getElementById('s1'), document.getElementById('s2'), document.getElementById('s3')];
            const text = document.getElementById('strength-text');
            
            bars.forEach((bar, i) => {
                bar.className = i < result.score ? 'active ' + result.level : '';
            });
            
            if (password.length === 0) {
                text.textContent = '';
                text.className = 'strength-text';
            } else {
                text.textContent = 'قوة كلمة المرور: ' + result.text;
                text.className = 'strength-text ' + result.level;
            }
        }

        // ============================================================
        // 3. VALIDATION
        // ============================================================
        function validateField(id, errorId, condition) {
            const field = document.getElementById(id);
            const error = document.getElementById(errorId);
            if (!field) return true;
            
            const value = field.value.trim();
            const isValid = condition(value);
            field.classList.toggle('error', !isValid && value.length > 0);
            error.classList.toggle('show', !isValid && value.length > 0);
            return isValid || value.length === 0;
        }

        function validateForm() {
            const nom = document.getElementById('nom').value.trim();
            const prenom = document.getElementById('prenom').value.trim();
            const email = document.getElementById('email').value.trim();
            const password = document.getElementById('password').value;
            const passwordConfirm = document.getElementById('password-confirm').value;
            const terms = document.getElementById('terms').checked;
            
            let valid = true;
            
            // Nom
            const nomValid = nom.length >= 2;
            document.getElementById('nom').classList.toggle('error', !nomValid && nom.length > 0);
            document.getElementById('nom-error').classList.toggle('show', !nomValid && nom.length > 0);
            if (!nomValid && nom.length > 0) valid = false;
            
            // Prénom
            const prenomValid = prenom.length >= 2;
            document.getElementById('prenom').classList.toggle('error', !prenomValid && prenom.length > 0);
            document.getElementById('prenom-error').classList.toggle('show', !prenomValid && prenom.length > 0);
            if (!prenomValid && prenom.length > 0) valid = false;
            
            // Email
            const emailValid = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
            document.getElementById('email').classList.toggle('error', !emailValid && email.length > 0);
            document.getElementById('email-error').classList.toggle('show', !emailValid && email.length > 0);
            if (!emailValid && email.length > 0) valid = false;
            
            // Password
            const passwordValid = password.length >= 6;
            document.getElementById('password').classList.toggle('error', !passwordValid && password.length > 0);
            document.getElementById('password-error').classList.toggle('show', !passwordValid && password.length > 0);
            if (!passwordValid && password.length > 0) valid = false;
            
            // Password confirm
            const confirmValid = password === passwordConfirm && passwordConfirm.length > 0;
            document.getElementById('password-confirm').classList.toggle('error', !confirmValid && passwordConfirm.length > 0);
            document.getElementById('password-confirm-error').classList.toggle('show', !confirmValid && passwordConfirm.length > 0);
            if (!confirmValid && passwordConfirm.length > 0) valid = false;
            
            // Terms
            document.getElementById('terms-error').classList.toggle('show', !terms);
            if (!terms) valid = false;
            
            return valid;
        }

        // ============================================================
        // 4. INSCRIPTION
        // ============================================================
        function handleRegister(e) {
            e.preventDefault();

            if (!validateForm()) {
                showToast('⚠️ الرجاء تصحيح الأخطاء في النموذج', 'error');
                return;
            }

            const nom = document.getElementById('nom').value.trim();
            const prenom = document.getElementById('prenom').value.trim();
            const email = document.getElementById('email').value.trim();
            const telephone = document.getElementById('telephone').value.trim();
            const password = document.getElementById('password').value;

            // Simuler une inscription (à remplacer par API)
            // Pour la démo, on crée un compte fictif
            if (email && password.length >= 6) {
                // Simuler un token
                const token = 'demo_token_' + Date.now();
                const user = {
                    id: Math.floor(Math.random() * 1000) + 1,
                    nom: nom,
                    prenom: prenom,
                    email: email,
                    telephone: telephone || null,
                    role: 'client'
                };

                // Sauvegarder dans localStorage
                localStorage.setItem('dar_athath_token', token);
                localStorage.setItem('dar_athath_user', JSON.stringify(user));

                showToast('🎉 مرحباً بك ' + user.prenom + '! تم إنشاء حسابك بنجاح', 'success');
                
                // Redirection après 1.5 secondes
                setTimeout(() => {
                    window.location.href = '/index.html';
                }, 1500);
            } else {
                showToast('❌ حدث خطأ أثناء إنشاء الحساب. الرجاء المحاولة مرة أخرى.', 'error');
            }
        }

        // ============================================================
        // 5. UI
        // ============================================================
        function initUI() {
            // Menu mobile
            const btnMenu = document.getElementById('btn-menu-mobile');
            const menuOverlay = document.getElementById('menu-mobile-overlay');
            const btnFermer = document.getElementById('btn-fermer-menu');

            btnMenu.addEventListener('click', function() {
                this.classList.toggle('active');
                menuOverlay.classList.toggle('active');
                document.body.style.overflow = menuOverlay.classList.contains('active') ? 'hidden' : '';
            });

            btnFermer.addEventListener('click', function() {
                btnMenu.classList.remove('active');
                menuOverlay.classList.remove('active');
                document.body.style.overflow = '';
            });

            menuOverlay.querySelectorAll('a').forEach(link => {
                link.addEventListener('click', function() {
                    btnMenu.classList.remove('active');
                    menuOverlay.classList.remove('active');
                    document.body.style.overflow = '';
                });
            });

            // Password toggle
            const toggleBtn = document.getElementById('toggle-password');
            const passwordInput = document.getElementById('password');
            toggleBtn.addEventListener('click', function() {
                const type = passwordInput.type === 'password' ? 'text' : 'password';
                passwordInput.type = type;
                this.textContent = type === 'password' ? '👁️' : '🙈';
            });

            const toggleBtnConfirm = document.getElementById('toggle-password-confirm');
            const passwordConfirmInput = document.getElementById('password-confirm');
            toggleBtnConfirm.addEventListener('click', function() {
                const type = passwordConfirmInput.type === 'password' ? 'text' : 'password';
                passwordConfirmInput.type = type;
                this.textContent = type === 'password' ? '👁️' : '🙈';
            });

            // Password strength
            document.getElementById('password').addEventListener('input', updatePasswordStrength);

            // Validation en temps réel
            const fields = ['nom', 'prenom', 'email', 'password', 'password-confirm'];
            const conditions = {
                'nom': (v) => v.length >= 2,
                'prenom': (v) => v.length >= 2,
                'email': (v) => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v),
                'password': (v) => v.length >= 6,
                'password-confirm': (v) => v === document.getElementById('password').value
            };
            
            fields.forEach(id => {
                const field = document.getElementById(id);
                if (field) {
                    field.addEventListener('blur', function() {
                        const value = this.value.trim();
                        const valid = conditions[id](value);
                        this.classList.toggle('error', !valid && value.length > 0);
                        const errorEl = document.getElementById(id + '-error');
                        if (errorEl) errorEl.classList.toggle('show', !valid && value.length > 0);
                    });
                    field.addEventListener('input', function() {
                        if (id === 'password-confirm') {
                            const valid = this.value === document.getElementById('password').value;
                            this.classList.toggle('error', !valid && this.value.length > 0);
                            document.getElementById('password-confirm-error').classList.toggle('show', !valid && this.value.length > 0);
                        }
                    });
                }
            });

            // Header scroll
            const header = document.getElementById('main-header');
            window.addEventListener('scroll', function() {
                header.classList.toggle('scrolled', window.pageYOffset > 50);
            });

            // Badge panier
            function updateBadge() {
                const badge = document.getElementById('panier-compteur');
                if (badge) {
                    const saved = JSON.parse(localStorage.getItem('dar_athath_panier') || '[]');
                    const total = saved.reduce((sum, item) => sum + (item.quantite || 1), 0);
                    badge.textContent = total;
                    badge.style.display = total > 0 ? 'flex' : 'none';
                }
            }
            updateBadge();

            window.addEventListener('storage', function(e) {
                if (e.key === 'dar_athath_panier') updateBadge();
            });

            // Vérifier si déjà connecté
            const token = localStorage.getItem('dar_athath_token');
            if (token) {
                // Rediriger vers la page d'accueil
                window.location.href = '/index.html';
            }
        }

        // ============================================================
        // 6. INITIALISATION
        // ============================================================
        function init() {
            initUI();
            document.getElementById('register-form').addEventListener('submit', handleRegister);
            console.log('✨ Page Inscription chargée');
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', init);
        } else {
            init();
        }

    })();
</script>
</body>
</html>
